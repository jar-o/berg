{
  "name": "berg",
  "version": "0.1.0",
  "private": true,
  "description": "Same-site crawler built on tracker-radar-collector's crawler and collectors.",
  "main": "src/berg.js",
  "bin": {
    "berg": "src/berg.js"
  },
  "imports": {
    "#radar/*": "./radar/*.js"
  },
  "scripts": {
    "postinstall": "npm ci --prefix radar --omit=dev --no-audit --no-fund",
    "crawl": "node src/berg.js",
    "test": "TRC_UNSAFE_DISABLE_SANDBOX=1 node test/berg.test.js",
    "lint": "prettier --check src/ test/",
    "format": "prettier --write src/ test/"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
